					<sprite depth="5" name="check" width="30" height="30" pos="10,-7" color="[iconColor]" sprite="ui_game_symbol_check" visible="{track2selected}" />
					<label depth="4" name="lbl" pos="56,-22" width="530" height="42" text="{track2name}" font_size="26" justify="left" pivot="left" />
				</rect>
				<rect name="track3" pos="10,-290" width="600" height="46" style="press, hover" visible="{track3visible}">
