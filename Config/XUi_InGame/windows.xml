					<sprite depth="5" name="check" width="30" height="30" pos="10,-7" color="[iconColor]" sprite="ui_game_symbol_check" visible="{track3selected}" />
					<label depth="4" name="lbl" pos="56,-22" width="530" height="42" text="{track3name}" font_size="26" justify="left" pivot="left" />
				</rect>
				<rect name="track4" pos="10,-338" width="600" height="46" style="press, hover" visible="{track4visible}">
					<sprite depth="2" name="bg" sprite="menu_empty3px" pos="0,0" width="600" height="44" color="[black]" type="sliced" fillcenter="true" globalopacitymod="0.7" sound="[recipe_click]" />
					<sprite depth="5" name="check" width="30" height="30" pos="10,-7" color="[iconColor]" sprite="ui_game_symbol_check" visible="{track4selected}" />
					<label depth="4" name="lbl" pos="56,-22" width="530" height="42" text="{track4name}" font_size="26" justify="left" pivot="left" />
				</rect>
				<rect name="track5" pos="10,-386" width="600" height="46" style="press, hover" visible="{track5visible}">
					<sprite depth="2" name="bg" sprite="menu_empty3px" pos="0,0" width="600" height="44" color="[black]" type="sliced" fillcenter="true" globalopacitymod="0.7" sound="[recipe_click]" />
					<sprite depth="5" name="check" width="30" height="30" pos="10,-7" color="[iconColor]" sprite="ui_game_symbol_check" visible="{track5selected}" />
					<label depth="4" name="lbl" pos="56,-22" width="530" height="42" text="{track5name}" font_size="26" justify="left" pivot="left" />
				</rect>
				<rect name="track6" pos="10,-434" width="600" height="46" style="press, hover" visible="{track6visible}">
					<sprite depth="2" name="bg" sprite="menu_empty3px" pos="0,0" width="600" height="44" color="[black]" type="sliced" fillcenter="true" globalopacitymod="0.7" sound="[recipe_click]" />
					<sprite depth="5" name="check" width="30" height="30" pos="10,-7" color="[iconColor]" sprite="ui_game_symbol_check" visible="{track6selected}" />
					<label depth="4" name="lbl" pos="56,-22" width="530" height="42" text="{track6name}" font_size="26" justify="left" pivot="left" />
				</rect>
				<rect name="track7" pos="10,-482" width="600" height="46" style="press, hover" visible="{track7visible}">
					<sprite depth="2" name="bg" sprite="menu_empty3px" pos="0,0" width="600" height="44" color="[black]" type="sliced" fillcenter="true" globalopacitymod="0.7" sound="[recipe_click]" />
					<sprite depth="5" name="check" width="30" height="30" pos="10,-7" color="[iconColor]" sprite="ui_game_symbol_check" visible="{track7selected}" />
					<label depth="4" name="lbl" pos="56,-22" width="530" height="42" text="{track7name}" font_size="26" justify="left" pivot="left" />
				</rect>
				<rect name="track8" pos="10,-530" width="600" height="46" style="press, hover" visible="{track8visible}">
					<sprite depth="2" name="bg" sprite="menu_empty3px" pos="0,0" width="600" height="44" color="[black]" type="sliced" fillcenter="true" globalopacitymod="0.7" sound="[recipe_click]" />
					<sprite depth="5" name="check" width="30" height="30" pos="10,-7" color="[iconColor]" sprite="ui_game_symbol_check" visible="{track8selected}" />
					<label depth="4" name="lbl" pos="56,-22" width="530" height="42" text="{track8name}" font_size="26" justify="left" pivot="left" />
				</rect>
				<rect name="track9" pos="10,-578" width="600" height="46" style="press, hover" visible="{track9visible}">
					<sprite depth="2" name="bg" sprite="menu_empty3px" pos="0,0" width="600" height="44" color="[black]" type="sliced" fillcenter="true" globalopacitymod="0.7" sound="[recipe_click]" />
					<sprite depth="5" name="check" width="30" height="30" pos="10,-7" color="[iconColor]" sprite="ui_game_symbol_check" visible="{track9selected}" />
					<label depth="4" name="lbl" pos="56,-22" width="530" height="42" text="{track9name}" font_size="26" justify="left" pivot="left" />
				</rect>

				<!-- страницы -->
				<rect name="pagePrev" pos="10,-636" width="120" height="44" style="press, hover" visible="{pagingVisible}">
					<sprite depth="4" name="bg" sprite="menu_empty3px" pos="0,0" width="120" height="42" color="[darkGrey]" type="sliced" fillcenter="true" globalopacitymod="0.9" sound="[paging_click]" />
					<label depth="5" name="lbl" pos="60,-21" width="120" height="42" text="&lt;" font_size="28" justify="center" pivot="center" />
				</rect>
				<rect name="pageNext" pos="140,-636" width="120" height="44" style="press, hover" visible="{pagingVisible}">
					<sprite depth="4" name="bg" sprite="menu_empty3px" pos="0,0" width="120" height="42" color="[darkGrey]" type="sliced" fillcenter="true" globalopacitymod="0.9" sound="[paging_click]" />
					<label depth="5" name="lbl" pos="60,-21" width="120" height="42" text="&gt;" font_size="28" justify="center" pivot="center" />
				</rect>

				<rect name="closeButton" pos="400,-636" width="210" height="44" style="press, hover">
					<sprite depth="4" name="bg" sprite="menu_empty3px" pos="0,0" width="210" height="42" color="[darkGrey]" type="sliced" fillcenter="true" globalopacitymod="0.9" sound="[paging_click]" />
					<label depth="5" name="lbl" pos="105,-21" width="210" height="42" text_key="cspeakerWindowClose" font_size="26" justify="center" pivot="center" />
				</rect>
			</rect>

		</window>

	</append>

</configs>
