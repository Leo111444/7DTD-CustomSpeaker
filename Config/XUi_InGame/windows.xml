<configs>

	<append xpath="/windows">

		<window name="customSpeakerWindow" anchor="CenterCenter" pos="-310,400" width="620" height="800" cursor_area="true"
		        controller="CustomSpeaker.SpeakerWindow, CustomSpeaker">

			<rect name="header" pos="0,0" height="43" depth="1">
				<headerbg />
				<label style="header.name" pos="6,-6" text_key="cspeakerWindowTitle" />
			</rect>

			<rect name="content" pos="0,-46" width="620" height="754" depth="1">
				<sprite depth="6" name="border" sprite="menu_empty3px" pos="0,0" width="620" height="754" color="[black]" type="sliced" fillcenter="false" globalopacitymod="0.9" />
				<sprite depth="1" name="backgroundMain" sprite="menu_empty3px" pos="2,-2" width="616" height="750" color="[darkGrey]" type="sliced" fillcenter="true" globalopacitymod="0.65" />

				<!-- питание / ручной выключатель -->
				<rect name="powerToggle" pos="10,-10" width="600" height="44" style="press, hover">
					<sprite depth="2" name="bg" sprite="menu_empty3px" pos="0,0" width="600" height="42" color="[black]" type="sliced" fillcenter="true" globalopacitymod="0.7" sound="[recipe_click]" />
					<label depth="4" name="powerLabel" pos="16,-21" width="570" height="40" text="{powerText}" font_size="26" justify="left" pivot="left" />
				</rect>

				<!-- радиус -->
				<rect name="radiusRow" pos="10,-60" width="600" height="44">
					<sprite depth="2" name="bg" sprite="menu_empty3px" pos="0,0" width="600" height="42" color="[black]" type="sliced" fillcenter="true" globalopacitymod="0.7" />
					<label depth="4" name="radiusLabel" pos="16,-21" width="380" height="40" text="{radiusText}" font_size="26" justify="left" pivot="left" />
					<rect name="radiusMinus" pos="420,-2" width="80" height="38" style="press, hover">
						<sprite depth="4" name="bg" sprite="menu_empty3px" pos="0,0" width="80" height="38" color="[darkGrey]" type="sliced" fillcenter="true" globalopacitymod="0.9" sound="[paging_click]" />
						<label depth="5" name="lbl" pos="40,-19" width="80" height="38" text="-" font_size="30" justify="center" pivot="center" />
					</rect>
					<rect name="radiusPlus" pos="510,-2" width="80" height="38" style="press, hover">
						<sprite depth="4" name="bg" sprite="menu_empty3px" pos="0,0" width="80" height="38" color="[darkGrey]" type="sliced" fillcenter="true" globalopacitymod="0.9" sound="[paging_click]" />
						<label depth="5" name="lbl" pos="40,-19" width="80" height="38" text="+" font_size="30" justify="center" pivot="center" />
					</rect>
				</rect>

				<label depth="4" name="listHeader" pos="16,-118" width="300" height="36" text_key="cspeakerWindowTracks" font_size="26" justify="left" pivot="left" />
				<label depth="4" name="pageLabel" pos="604,-118" width="300" height="36" text="{pageText}" font_size="26" justify="right" pivot="right" />

				<!-- список треков -->
				<rect name="track0" pos="10,-146" width="600" height="46" style="press, hover" visible="{track0visible}">
					<sprite depth="2" name="bg" sprite="menu_empty3px" pos="0,0" width="600" height="44" color="[black]" type="sliced" fillcenter="true" globalopacitymod="0.7" sound="[recipe_click]" />
					<sprite depth="5" name="check" width="30" height="30" pos="10,-7" color="[iconColor]" sprite="ui_game_symbol_check" visible="{track0selected}" />
					<label depth="4" name="lbl" pos="56,-22" width="530" height="42" text="{track0name}" font_size="26" justify="left" pivot="left" />
				</rect>
				<rect name="track1" pos="10,-194" width="600" height="46" style="press, hover" visible="{track1visible}">
					<sprite depth="2" name="bg" sprite="menu_empty3px" pos="0,0" width="600" height="44" color="[black]" type="sliced" fillcenter="true" globalopacitymod="0.7" sound="[recipe_click]" />
					<sprite depth="5" name="check" width="30" height="30" pos="10,-7" color="[iconColor]" sprite="ui_game_symbol_check" visible="{track1selected}" />
					<label depth="4" name="lbl" pos="56,-22" width="530" height="42" text="{track1name}" font_size="26" justify="left" pivot="left" />
				</rect>
				<rect name="track2" pos="10,-242" width="600" height="46" style="press, hover" visible="{track2visible}">
